---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../data/services';
---

<BaseLayout title="Services">
  <section class="section">
    <h2 class="section-title">Services</h2>
    <p style="color:var(--text-secondary);font-size:0.92rem;margin-bottom:24px;max-width:640px;">
      I design AI-powered products and build them using multi-agent systems.
      Here's how I can help you.
    </p>
    <div class="services-grid">
      {services.map(s => (
        <div class="service-card fade-in">
          <div class="icon">
            {s.icon === 'bot' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><circle cx="12" cy="5" r="2"/><path d="M12 7v4"/><line x1="8" y1="16" x2="8" y2="16"/><line x1="16" y1="16" x2="16" y2="16"/></svg>}
            {s.icon === 'message-square' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>}
            {s.icon === 'search' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>}
            {s.icon === 'mic' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>}
          </div>
          <h3>{s.title}</h3>
          <p>{s.description}</p>
          <a href={s.ctaLink} class="cta-link">{s.ctaText} →</a>
        </div>
      ))}
    </div>
  </section>

  <section class="cta-section fade-in">
    <h2>Not sure what you need?</h2>
    <p>Tell me about your idea and I'll suggest the best approach.</p>
    <a href="/Portfolio/contact/" class="btn btn-primary">Let's Talk</a>
  </section>
</BaseLayout>
