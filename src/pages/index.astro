---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
const featured = projects.filter(p => p.featured);
---

<BaseLayout>
  <section class="hero">
    <h1>Vishal Khajuriya</h1>
    <div class="tagline">AI Product Builder</div>
    <div class="sub">I design AI products. AI builds them.</div>
    <div class="hero-cta">
      <a href="/Portfolio/projects/" class="btn btn-primary">View Projects</a>
      <a href="/Portfolio/contact/" class="btn btn-outline">Contact Me</a>
    </div>
  </section>

  <section class="section fade-in">
    <h2 class="section-title">About</h2>
    <p class="about-text">
      I build AI-powered products by directing multi-agent systems.
      I focus on the <strong>what</strong> and <strong>why</strong> —
      the AI handles the <strong>how</strong>. Based in Bhopal, India,
      I turn ideas into working software using modern AI tooling.
    </p>
  </section>

  <section class="section fade-in">
    <h2 class="section-title">Featured Projects</h2>
    <div class="project-grid">
      {featured.map(p => (
        <a href={`/Portfolio/projects/${p.slug}/`} class="project-card">
          <h3>
            {p.title}
            <span class={`status-badge status-${p.status === 'complete' ? 'complete' : 'in-progress'}`}>
              {p.status === 'complete' ? 'Complete' : 'In Progress'}
            </span>
          </h3>
          <div class="desc">{p.shortDescription}</div>
          <div class="tech">{p.tech.join(' • ')}</div>
          <span class="card-link">View details →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section fade-in">
    <h2 class="section-title">Skills</h2>
    <div class="skills-tags">
      <span class="skill-tag">AI Product Development</span>
      <span class="skill-tag">Multi-Agent Systems</span>
      <span class="skill-tag">Python</span>
      <span class="skill-tag">Gemini API</span>
      <span class="skill-tag">OpenAI API</span>
      <span class="skill-tag">Streamlit</span>
      <span class="skill-tag">FastAPI</span>
      <span class="skill-tag">Flask</span>
      <span class="skill-tag">Vector Search</span>
      <span class="skill-tag">RAG Pipelines</span>
      <span class="skill-tag">Voice AI</span>
      <span class="skill-tag">Web Scraping</span>
      <span class="skill-tag">Prompt Engineering</span>
      <span class="skill-tag">TradingView / Pine Script</span>
    </div>
  </section>

  <section class="cta-section fade-in">
    <h2>Ready to build something?</h2>
    <p>Let's turn your idea into working software.</p>
    <a href="/Portfolio/contact/" class="btn btn-primary">Get in Touch</a>
  </section>
</BaseLayout>
